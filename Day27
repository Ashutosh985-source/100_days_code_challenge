#include <stdio.h>

#define ROWS 3
#define COLS 4

// Function to display parking layout
void displayParking(int parking[ROWS][COLS])
{
    printf("\nParking Layout:\n");

    for (int i = 0; i < ROWS; i++)
    {
        for (int j = 0; j < COLS; j++)
        {
            printf("%d ", parking[i][j]);
        }
        printf("\n");
    }
}

// Function to find and allocate first available spot
int parkCar(int parking[ROWS][COLS])
{
    for (int i = 0; i < ROWS; i++)
    {
        for (int j = 0; j < COLS; j++)
        {
            if (parking[i][j] == 0)
            {
                // Park the car
                parking[i][j] = 1;

                printf("\nCar parked successfully!\n");
                printf("Allocated spot: Row %d, Column %d\n", i, j);

                return 1;
            }
        }
    }

    return 0;
}

int main()
{
    int parking[ROWS][COLS] =
    {
        {1, 1, 0, 1},
        {1, 0, 1, 1},
        {0, 1, 1, 0}
    };

    printf("Before parking:");
    displayParking(parking);

    if (!parkCar(parking))
    {
        printf("\nParking is full! No spot available.\n");
    }

    printf("\nAfter parking:");
    displayParking(parking);

    return 0;
}
