#include <stdio.h>

int findPeakElement(int nums[], int n) {

    int low = 0;
    int high = n - 1;

    while (low < high) {

        int mid = low + (high - low) / 2;

        // If slope is increasing,
        // peak must exist on the right side
        if (nums[mid] < nums[mid + 1]) {
            low = mid + 1;
        }

        // Otherwise peak exists on left side
        // or mid itself can be the peak
        else {
            high = mid;
        }
    }

    return low;
}

int main() {

    int nums[] = {1, 2, 3, 1};

    int n = sizeof(nums) / sizeof(nums[0]);

    int peakIndex = findPeakElement(nums, n);

    printf("Peak element = %d\n", nums[peakIndex]);
    printf("Peak index = %d\n", peakIndex);

    return 0;
}
