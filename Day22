#include <stdio.h>

int main() {
    int arr[] = {0, 1, 0, 3, 12};
    int n = sizeof(arr) / sizeof(arr[0]);

    int result[n];
    int index = 0;

    // Copy non-zero elements
    for (int i = 0; i < n; i++) {
        if (arr[i] != 0) {
            result[index] = arr[i];
            index++;
        }
    }

    // Fill remaining positions with zero
    while (index < n) {
        result[index] = 0;
        index++;
    }

    printf("Array after shifting zeros: ");

    for (int i = 0; i < n; i++) {
        printf("%d ", result[i]);
    }

    return 0;
}
