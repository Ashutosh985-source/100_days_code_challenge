#include <stdio.h>
#include <stdlib.h>

int compare(const void *a, const void *b) {
    int x = *(const int *)a;
    int y = *(const int *)b;

    if (x < y) return 1;
    if (x > y) return -1;
    return 0;
}

int main() {
    int arr[] = {3, 2, 1, 5, 6, 4};
    int n = sizeof(arr) / sizeof(arr[0]);
    int k = 2;

    qsort(arr, n, sizeof(int), compare);

    printf("%dth largest element = %d\n", k, arr[k - 1]);

    return 0;
}
