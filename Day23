#include <stdio.h>

#define MAX 100

void bucketSort(int arr[], int n) {
    int max = arr[0];

    // Step 1: Find maximum element
    for (int i = 1; i < n; i++) {
        if (arr[i] > max) {
            max = arr[i];
        }
    }

    // Step 2: Create buckets
    int bucket[MAX] = {0};

    // Step 3: Store frequency of each element
    for (int i = 0; i < n; i++) {
        bucket[arr[i]]++;
    }

    // Step 4: Put elements back into original array
    int index = 0;

    for (int i = 0; i <= max; i++) {
        while (bucket[i] > 0) {
            arr[index] = i;
            index++;
            bucket[i]--;
        }
    }
}

int main() {
    int arr[] = {5, 3, 8, 1, 2, 7, 3, 4};
    int n = sizeof(arr) / sizeof(arr[0]);

    printf("Original Array:\n");

    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    bucketSort(arr, n);

    printf("\n\nSorted Array:\n");

    for (int i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
