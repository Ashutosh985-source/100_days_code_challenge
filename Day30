#include <stdio.h>
#include <stdlib.h>

int compare(const void *a, const void *b)
{
    int x = *(const int *)a;
    int y = *(const int *)b;

    if (x < y) return -1;
    if (x > y) return 1;
    return 0;
}

int firstMissingPositive(int arr[], int n)
{
    // Sort the array
    qsort(arr, n, sizeof(int), compare);

    int missing = 1;

    for (int i = 0; i < n; i++)
    {
        // Ignore negative numbers and zero
        if (arr[i] <= 0)
            continue;

        if (arr[i] == missing)
        {
            missing++;
        }
        else if (arr[i] > missing)
        {
            return missing;
        }
    }

    return missing;
}

int main()
{
    int arr[] = {3, 4, -1, 1};

    int n = sizeof(arr) / sizeof(arr[0]);

    int result = firstMissingPositive(arr, n);

    printf("First missing positive number = %d\n", result);

    return 0;
}
