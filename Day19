#include <stdio.h>
#include <string.h>

int main() {
    char mainString[100], subString[100];
    int freq1[256] = {0};
    int freq2[256] = {0};

    printf("Enter main string: ");
    scanf("%s", mainString);

    printf("Enter substring: ");
    scanf("%s", subString);

    // Anagrams must have the same length
    if (strlen(mainString) != strlen(subString)) {
        printf("The substring is not an anagram of the main string.\n");
        return 0;
    }

    // Count frequency of characters
    for (int i = 0; mainString[i] != '\0'; i++) {
        freq1[(unsigned char)mainString[i]]++;
        freq2[(unsigned char)subString[i]]++;
    }

    // Compare frequencies
    for (int i = 0; i < 256; i++) {
        if (freq1[i] != freq2[i]) {
            printf("The substring is not an anagram of the main string.\n");
            return 0;
        }
    }

    printf("The substring is an anagram of the main string.\n");

    return 0;
}
