#include <stdio.h>

int squareRoot(int n)
{
    if (n == 0 || n == 1)
        return n;

    int ans = 0;

    for (int i = 1; i <= n / i; i++)
    {
        ans = i;
    }

    return ans;
}

int main()
{
    int n;

    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 0)
    {
        printf("Square root of a negative number is not real.\n");
        return 0;
    }

    printf("Integer square root = %d\n", squareRoot(n));

    return 0;
}
