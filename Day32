#include <stdio.h>

int main()
{
    int arr[] = {2, 0, 3, -2, -1, 0, 1};
    int n = sizeof(arr) / sizeof(arr[0]);

    printf("Triplets with sum 0:\n");

    for (int i = 0; i < n - 2; i++)
    {
        for (int j = i + 1; j < n - 1; j++)
        {
            for (int k = j + 1; k < n; k++)
            {
                if (arr[i] + arr[j] + arr[k] == 0)
                {
                    printf("%d %d %d\n",
                           arr[i], arr[j], arr[k]);
                }
            }
        }
    }

    return 0;
}
